[
 {
  "key": "28afc179cf9a",
  "text": "자, 문제!"
 },
 {
  "key": "d0698c10f6ce",
  "text": "문제 나간다!"
 },
 {
  "key": "4811df91d1ea",
  "text": "이번 문제야."
 },
 {
  "key": "07b21907ec5a",
  "text": "잘 들어 봐!"
 },
 {
  "key": "83336d05c08d",
  "text": "딩동댕!"
 },
 {
  "key": "b09f2a4cefc6",
  "text": "맞았어!"
 },
 {
  "key": "4c68e0253312",
  "text": "정답!"
 },
 {
  "key": "33f7583b2876",
  "text": "잘했어!"
 },
 {
  "key": "ed66c8a6bae5",
  "text": "맞아, 역시!"
 },
 {
  "key": "50d671ef360f",
  "text": "좋아, 정답이야!"
 },
 {
  "key": "a52eb9a10be3",
  "text": "앗, 아깝다!"
 },
 {
  "key": "561ed396806f",
  "text": "아쉽다!"
 },
 {
  "key": "ff9e24173c4b",
  "text": "음, 이건 틀렸어."
 },
 {
  "key": "016a047ef629",
  "text": "생명력이 다 떨어졌어."
 },
 {
  "key": "8520b4edfc0d",
  "text": "오브를 모으고 충돌을 피하면 더 오래 달릴 수 있어!"
 },
 {
  "key": "965143995129",
  "text": "AUTO 데모 주행 중"
 },
 {
  "key": "c261edf80f7d",
  "text": "화면 왼쪽, 오른쪽 절반을 눌러서 조향!"
 },
 {
  "key": "7be6074ba168",
  "text": "◀ ▶ 버튼으로 조향!"
 },
 {
  "key": "b4c02a653f63",
  "text": "코너에서는 드리프트를 누른 채 꺾으면 터보 충전."
 },
 {
  "key": "3d67f53648c9",
  "text": "자, 출발!"
 },
 {
  "key": "529c04cd4165",
  "text": "왼쪽으로 가 보기"
 },
 {
  "key": "177658cac842",
  "text": "화면 왼쪽 절반을 누르고 있으면 왼쪽으로 가요."
 },
 {
  "key": "8d037c98cfa2",
  "text": "왼쪽의 노란 오브를 모아 보세요!"
 },
 {
  "key": "18598dc68743",
  "text": "왼쪽 아래 ◀ 버튼을 누르고 있으면 왼쪽으로 가요."
 },
 {
  "key": "82d4cdfbce0b",
  "text": "이번엔 오른쪽!"
 },
 {
  "key": "4cd947fce8be",
  "text": "화면 오른쪽 절반을 누르고 있어 보세요."
 },
 {
  "key": "0e3eb35542b4",
  "text": "손을 떼면 그 자리에서 똑바로 달려요."
 },
 {
  "key": "fb38113e5c46",
  "text": "▶ 버튼을 누르고 있어 보세요."
 },
 {
  "key": "f8e1717aace6",
  "text": "점프로 넘기"
 },
 {
  "key": "aa00a3449fd3",
  "text": "빨간 파동이 다가오면 오른쪽 아래 [점프]!"
 },
 {
  "key": "076a73af81c6",
  "text": "공중에 뜬 동안은 부딪히지 않아요."
 },
 {
  "key": "e77c5b7bafec",
  "text": "드리프트로 코너 돌기"
 },
 {
  "key": "c74e7b3cc022",
  "text": "급커브예요!"
 },
 {
  "key": "82786ea6af3d",
  "text": "[드리프트]를 누른 채 커브 쪽으로 꺾고, 커브를 빠져나오면 손을 떼세요."
 },
 {
  "key": "89893225a29b",
  "text": "불꽃 색이 바뀔수록 강한 미니 터보!"
 },
 {
  "key": "4d9c0f0a3662",
  "text": "부스트"
 },
 {
  "key": "81a283c82c08",
  "text": "[부스트]를 누르면 화면 아래 파란 '신호 에너지'를 써서 빨라져요."
 },
 {
  "key": "ee3852f35ba9",
  "text": "에너지는 오브와 드리프트로 채워요."
 },
 {
  "key": "25389f855d70",
  "text": "정답 게이트"
 },
 {
  "key": "9e50fddbf489",
  "text": "문제가 나오면 정답 보기가 있는 차선으로 들어가요."
 },
 {
  "key": "e09f565338de",
  "text": "화면 아래 '지금 A ."
 },
 {
  "key": "180f8c809790",
  "text": "'가 지금 내 차선이에요."
 },
 {
  "key": "e5b7de18e721",
  "text": "문제가 뜨는 동안은 조금 느려져요."
 },
 {
  "key": "dfa9d82efbad",
  "text": "연습 끝!"
 },
 {
  "key": "86f522cfaf41",
  "text": "잘했어요!"
 },
 {
  "key": "d98d9c9d22aa",
  "text": "이제 진짜 신경계를 달려 봐요."
 },
 {
  "key": "b87fd89d41d1",
  "text": "결승선까지 쭉!"
 },
 {
  "key": "939067782dc3",
  "text": "좋아, 완벽해!"
 },
 {
  "key": "fc3b569a50f7",
  "text": "바로 그거야!"
 },
 {
  "key": "5dd66a17382b",
  "text": "붕괴 탈출 성공!"
 },
 {
  "key": "7b7f9329e376",
  "text": "탈수초가 퍼지기 전에 신호 전달"
 },
 {
  "key": "237fc4fa0ed2",
  "text": "탈출"
 },
 {
  "key": "18193a64e4f0",
  "text": "탈출 성공!"
 },
 {
  "key": "d600daca6814",
  "text": "수초가 무너지면 전도가 느려지니까, 신호가 붕괴보다 빨라야 해!"
 },
 {
  "key": "4abe91f005c0",
  "text": "해냈어!"
 },
 {
  "key": "dc7337f8b6e8",
  "text": "널의 체력이 0이야!"
 },
 {
  "key": "e86dd2efddd9",
  "text": "신경망이 다시 깨어나고 있어!"
 },
 {
  "key": "236536be084e",
  "text": "널 소멸!"
 },
 {
  "key": "393b23c4c1ad",
  "text": "신경망 복구!"
 },
 {
  "key": "d2c7ad19db98",
  "text": "슈퍼 콤보!"
 },
 {
  "key": "3aadd98ff098",
  "text": "결절마다 활동전위가 다시 만들어져서 신호가 껑충껑충 뛰고 있어!"
 },
 {
  "key": "dc56f96356ab",
  "text": "균형 유지"
 },
 {
  "key": "60da7355f72f",
  "text": "% — 소뇌 보정 성공!"
 },
 {
  "key": "5bbe10850122",
  "text": "가속"
 },
 {
  "key": "45c89bab340d",
  "text": "균형"
 },
 {
  "key": "fcb6031a886d",
  "text": "소뇌는 이렇게 동작 오차를 계속 고쳐 줘."
 },
 {
  "key": "9bac7dd6be77",
  "text": "⚡ 역치 도달!"
 },
 {
  "key": "2a1316369605",
  "text": "활동전위 발화!"
 },
 {
  "key": "86093975848d",
  "text": "발화!"
 },
 {
  "key": "1d68888d63ff",
  "text": "활동전위다!"
 },
 {
  "key": "d4955a73b110",
  "text": "역치 넘었다!"
 },
 {
  "key": "9c50db114a87",
  "text": "슝!"
 },
 {
  "key": "e63a8758bc50",
  "text": "좋아, 발화 성공!"
 },
 {
  "key": "0fea49f40627",
  "text": "과흥분!"
 },
 {
  "key": "14943e1b5405",
  "text": "발작 위험 — IPSP로 진정시켜!"
 },
 {
  "key": "79c3baf64374",
  "text": "앗, 과흥분이야!"
 },
 {
  "key": "29d75e4d3613",
  "text": "파란 IPSP를 모아 줘!"
 },
 {
  "key": "47ecb59c955f",
  "text": "EPSP 가중 성공!"
 },
 {
  "key": "101f636ee5f7",
  "text": "발화"
 },
 {
  "key": "1936014d143e",
  "text": "과흥분 억제 성공!"
 },
 {
  "key": "47c75cc59bbd",
  "text": "보너스 가속"
 },
 {
  "key": "7862cb79e009",
  "text": "시간적 가중 성공!"
 },
 {
  "key": "93e388df0ca5",
  "text": "EPSP가 모여서 발화했어!"
 },
 {
  "key": "a7669a9c317a",
  "text": "IPSP가 막전위를 낮춰서 과흥분을 막았어!"
 },
 {
  "key": "06aede7eb90e",
  "text": "역치에 못 미쳤어요 — EPSP를 더 빨리 연달아!"
 },
 {
  "key": "141086724107",
  "text": "억제 실패 — 과흥분이 일어났어요"
 },
 {
  "key": "90c814fa2e00",
  "text": "아깝다!"
 },
 {
  "key": "0b0a950b2642",
  "text": "EPSP를 더 빠르게 연달아 모아야 역치까지 가."
 },
 {
  "key": "52fa6a64ddaa",
  "text": "과흥분이 일어났어."
 },
 {
  "key": "872f8138e3b3",
  "text": "IPSP를 더 모아 보자!"
 },
 {
  "key": "0d60ce742391",
  "text": "코너 진입!"
 },
 {
  "key": "a689e2dde1c6",
  "text": "안쪽으로 조향해 벽에 부딪히지 않게 하세요."
 },
 {
  "key": "25dc8c2313f3",
  "text": "널 교란 구간!"
 },
 {
  "key": "20173d16def8",
  "text": "큰 파동은 [점프], 작은 블록은 피하세요."
 },
 {
  "key": "aff3fea4fa5d",
  "text": "360° 루프!"
 },
 {
  "key": "54c1885b9af6",
  "text": "최고 속도로 들어가야 벽을 타고 한 바퀴 돌 수 있어요."
 },
 {
  "key": "9dea72107356",
  "text": "부스트를 아껴 두세요."
 },
 {
  "key": "9c6c8cce7f86",
  "text": "시냅스 워프 포털!"
 },
 {
  "key": "d516b0490210",
  "text": "전달 순서를 맞히면 다음 구간으로 워프 가속."
 },
 {
  "key": "41200e52f23d",
  "text": "신경가소성 갈림길!"
 },
 {
  "key": "bb3b7bbb4b22",
  "text": "같은 챕터를 정답률 80% 이상으로 3번 클리어하면 지름길이 열려요."
 },
 {
  "key": "aefe2094cc14",
  "text": ", 자주 쓰는 연결이 강해지는 '장기강화'의 비유,"
 },
 {
  "key": "206b15dd06a3",
  "text": "널 코어!"
 },
 {
  "key": "18e59a3f386f",
  "text": "부스트나 미니 터보 상태로 노란 링을 통과하면 3배 대미지."
 },
 {
  "key": "59e08a20b398",
  "text": "S자 커브!"
 },
 {
  "key": "ec8f8698a007",
  "text": "리듬 타고 좌우로 — 오브 라인을 따라가요."
 },
 {
  "key": "57ec23ab4bb2",
  "text": "점프대!"
 },
 {
  "key": "2bc0d44e6802",
  "text": "가운데로 올라타면 높이 날아 장애물을 넘어요."
 },
 {
  "key": "d1e1d50780dd",
  "text": "움직이는 널 블록!"
 },
 {
  "key": "283428f11eda",
  "text": "좌우로 오가니 빈틈을 노려요."
 },
 {
  "key": "0dd91dea84df",
  "text": "레이저 장벽!"
 },
 {
  "key": "b4458a99989c",
  "text": "빨간 빛이 켜져 있을 땐 점프로 넘거나 꺼질 때 통과."
 },
 {
  "key": "c76795f7f5df",
  "text": "좁은 통로!"
 },
 {
  "key": "ed446bfd052d",
  "text": "벽에 부딪히면 콤보가 끊겨요."
 },
 {
  "key": "290698c16360",
  "text": "드리프트 충전 구간!"
 },
 {
  "key": "a67a257fed5d",
  "text": "여기선 드리프트 충전이 1."
 },
 {
  "key": "951be1acf10b",
  "text": "8배 빨라요."
 },
 {
  "key": "ff8924e128c2",
  "text": "말이집 구간!"
 },
 {
  "key": "b397ec699787",
  "text": "결절, 링, 을 3, 5, 10연속 통과하면 부스트 — 정중앙이면 PERFECT!"
 },
 {
  "key": "78c351fecdcc",
  "text": "갈래 길!"
 },
 {
  "key": "c975fa691da4",
  "text": "왼쪽은 안전, 오른쪽은 위험하지만 오브 3배."
 },
 {
  "key": "6ba440a1c260",
  "text": "급커브!"
 },
 {
  "key": "5a6a08207113",
  "text": "[드리프트]를 누른 채 커브 방향으로 조향 , 그다음 놓으면 미니 터보!"
 },
 {
  "key": "798bd128305f",
  "text": "축삭 붕괴가 뒤에서 쫓아와요!"
 },
 {
  "key": "91cace7f83c8",
  "text": "충돌하면 붙잡혀요 — 초록 복구 오브로 버티며 탈출!"
 },
 {
  "key": "3d6cf02e7811",
  "text": "뒤에서 축삭이 무너지고 있어!"
 },
 {
  "key": "38bedc4b9f36",
  "text": "멈추지 말고 달려!"
 },
 {
  "key": "07b43470ee98",
  "text": "널이 신호를 흩뜨리고 있어!"
 },
 {
  "key": "d1ad0fe8421e",
  "text": "피하면서 에너지를 모으자!"
 },
 {
  "key": "69e6d333c205",
  "text": "증상을 보고 정확히 진단해야 약점이 열려!"
 },
 {
  "key": "3f28ec597f7d",
  "text": "마지막이야!"
 },
 {
  "key": "e73a0416d368",
  "text": "진단하고, 부스트로 코어를 뚫자!"
 },
 {
  "key": "3f333d2510ff",
  "text": "뇌줄기 신경핵 탐험!"
 },
 {
  "key": "bed5a817a8ba",
  "text": "지금 층에 있는 신경핵 차선으로!"
 },
 {
  "key": "5198b4e5ca30",
  "text": "시상 중계 미션!"
 },
 {
  "key": "01a5ef1054bd",
  "text": "감각 신호를 맞는 중계핵으로 보내!"
 },
 {
  "key": "608e8d820926",
  "text": "대뇌 기능 포털!"
 },
 {
  "key": "987b8cd6f48d",
  "text": "명령에 맞는 겉질 영역으로!"
 },
 {
  "key": "334ce0a18c93",
  "text": "12뇌신경 포털!"
 },
 {
  "key": "751ee706e90b",
  "text": "동작에 맞는 뇌신경으로!"
 },
 {
  "key": "16b97771d3e2",
  "text": "왼다리 진동 감각을 실어 나르자!"
 },
 {
  "key": "b6e0e137e1e4",
  "text": "뒤기둥-안쪽섬유띠계는 어디서 교차할까?"
 },
 {
  "key": "9a26aa52440f",
  "text": "왼손 통증 신호!"
 },
 {
  "key": "209dae615142",
  "text": "앞가쪽계는 언제 건너갈까?"
 },
 {
  "key": "019afa6103ef",
  "text": "왼손을 움직이는 명령!"
 },
 {
  "key": "d0a03e6e2e97",
  "text": "겉질척수로는 어디서 교차할까?"
 },
 {
  "key": "ef7c8fbadeea",
  "text": "층마다 맞는 쪽 차선으로 드리프트!"
 },
 {
  "key": "617d4ddb847b",
  "text": "척수반사 긴급 미션!"
 },
 {
  "key": "0a488a9a94f9",
  "text": "자극이 보이면 바로 반응 — 신장=부스트, 굽힘=점프, 교차폄=반대쪽으로, 상호억제=아무것도 누르지 않기."
 },
 {
  "key": "cde6b10b93d3",
  "text": ", 실제 반사는 수십 ms로 훨씬 빨라요,"
 },
 {
  "key": "8c7c75b5bde5",
  "text": "척수반사 미션이야!"
 },
 {
  "key": "2166c27c45fb",
  "text": "자극이 나오면 바로 반응해!"
 },
 {
  "key": "9741544452e5",
  "text": "소뇌 균형 라인!"
 },
 {
  "key": "38c778e21707",
  "text": "널이 몸을 흔들어요, 운동실조 흉내."
 },
 {
  "key": "912ccd81d39d",
  "text": "빛나는 선 위에 머물러 오차를 보정하세요."
 },
 {
  "key": "5fcbd6a7f5e5",
  "text": "빛나는 선을 따라가!"
 },
 {
  "key": "6b2804d5fb7d",
  "text": "흔들려도 소뇌처럼 바로바로 고쳐 줘!"
 },
 {
  "key": "7dfb4c4c98b2",
  "text": "EPSP 가중 구간!"
 },
 {
  "key": "79ca47b05bc0",
  "text": "초록 ＋ 를 연달아 먹으면 막전위가 올라가 역치에서 발화 , 그다음 가속!"
 },
 {
  "key": "0e5da1bb50f7",
  "text": "파랑 − 는 피하기"
 },
 {
  "key": "77b6f559764b",
  "text": "IPSP 억제 구간!"
 },
 {
  "key": "d5a7e37491e8",
  "text": "널이 막전위를 계속 올려요."
 },
 {
  "key": "775b1e78611b",
  "text": "파랑 − 를 먹어서 역치 아래로 지키기!"
 },
 {
  "key": "6ffb1b94b18d",
  "text": "초록 ＋ 는 피하기"
 },
 {
  "key": "35aa06ab9e4d",
  "text": "EPSP 구간이야!"
 },
 {
  "key": "27d5f87ef182",
  "text": "초록 플러스를 연달아 모으면 역치까지 올라가서 발화해!"
 },
 {
  "key": "7987c53b6d56",
  "text": "널 때문에 뉴런이 과흥분 중이야!"
 },
 {
  "key": "d160350eb2d1",
  "text": "파란 마이너스를 모아서 진정시켜 줘!"
 },
 {
  "key": "71f59d964cb2",
  "text": "골인!"
 },
 {
  "key": "769c3cf683af",
  "text": "신호 전달 성공!"
 },
 {
  "key": "2bc6c2d6c6a5",
  "text": "도착!"
 },
 {
  "key": "dc9eb7a7136d",
  "text": "우리가 해냈어!"
 },
 {
  "key": "1fb37ade6ffc",
  "text": "신경 신호 무사히 도착!"
 },
 {
  "key": "7c31a588b2f3",
  "text": "시냅스 게이트야!"
 },
 {
  "key": "9899755f0599",
  "text": "순서대로 눌러 줘."
 },
 {
  "key": "9266422520d8",
  "text": "좋아, 마지막 문제!"
 },
 {
  "key": "d5ec396eedf0",
  "text": "오답."
 },
 {
  "key": "9b3eb442ed20",
  "text": "정답은"
 },
 {
  "key": "ec886ceff6de",
  "text": "이제 진짜 신경계로 출발하자!"
 },
 {
  "key": "027d71c65a34",
  "text": "우와, 진화했어!"
 },
 {
  "key": "60cbe032f132",
  "text": "이제 나는"
 },
 {
  "key": "f330ac023e76",
  "text": "야!"
 },
 {
  "key": "d09580c20f5a",
  "text": "완벽해!"
 },
 {
  "key": "e703d36015b2",
  "text": "문제를 전부 맞혔어!"
 },
 {
  "key": "0cb79981a63a",
  "text": "완주 성공!"
 },
 {
  "key": "5a2459e468ee",
  "text": "틀린 문제는 오답 노트에서 같이 다시 보자."
 },
 {
  "key": "4a96ffc75b58",
  "text": "안녕!"
 },
 {
  "key": "ad4c136ca07d",
  "text": "나는 스타 제로원이야."
 },
 {
  "key": "07c084387aa5",
  "text": "이렇게 읽어 줄게!"
 },
 {
  "key": "56282a832e2b",
  "text": "이 목소리 어때?"
 },
 {
  "key": "8bc17f26a725",
  "text": "나는 스타 제로원!"
 },
 {
  "key": "e1ead2a3707d",
  "text": "같이 신경계를 달려 보자!"
 },
 {
  "key": "8cbe9c0ea55c",
  "text": "미션 성공!"
 },
 {
  "key": "93119267ee14",
  "text": "다시 달리자!"
 },
 {
  "key": "f505c3ddc707",
  "text": "아쉽지만 괜찮아, 다시 달리자!"
 },
 {
  "key": "a62124c64878",
  "text": "카드에 적힌 신경핵이 뇌줄기의 어느 층에 있는지 골라 제자리에 꽂아 주세요."
 },
 {
  "key": "0c8ffa8f931c",
  "text": "맞히면 그 층이 빛나요."
 },
 {
  "key": "bf87bce75be1",
  "text": "3번 눈돌림신경핵"
 },
 {
  "key": "f6d7f9f0ae60",
  "text": "4번 도르래신경핵"
 },
 {
  "key": "c0edf2fa6dc5",
  "text": "에딩거-웨스트팔핵 , 동공 수축,"
 },
 {
  "key": "54ea00f91e7b",
  "text": "5번 삼차신경 운동핵 , 씹기,"
 },
 {
  "key": "5f4a764f4096",
  "text": "6번 갓돌림신경핵"
 },
 {
  "key": "e98007c4f4d7",
  "text": "7번 얼굴신경핵"
 },
 {
  "key": "2edf35754231",
  "text": "12번 혀밑신경핵"
 },
 {
  "key": "4e9b712ff3de",
  "text": "의문핵 , 삼킴 , 발성,"
 },
 {
  "key": "58b95c3c986e",
  "text": "10번 미주신경 등쪽운동핵"
 },
 {
  "key": "9ac3b869ce23",
  "text": "III, 4번 는 중간뇌, V, VI, 7번 은 다리뇌, IX, X, 12번 은 숨뇌 — 위에서 아래로 번호가 커져요."
 },
 {
  "key": "672db6d053ab",
  "text": "명령이 떨어지면 그 일을 맡은 대뇌겉질 영역을 눌러 주세요."
 },
 {
  "key": "82841351c0cd",
  "text": "왼쪽 반구를 옆에서 본 모습이고, 왼쪽이 이마, 앞, 예요."
 },
 {
  "key": "f32bf67380cb",
  "text": "오른손을 움직여라!"
 },
 {
  "key": "3c02c40a2f31",
  "text": "손끝 감촉을 느껴라!"
 },
 {
  "key": "5adeb527692e",
  "text": "말을 만들어 내라!"
 },
 {
  "key": "0721b085d76b",
  "text": "들은 말을 이해하라!"
 },
 {
  "key": "0b860564dc11",
  "text": "음악 소리를 들어라!"
 },
 {
  "key": "706072957699",
  "text": "물체의 모양을 보라!"
 },
 {
  "key": "e2a7630c7e27",
  "text": "운동은 중심앞이랑, 몸감각은 중심뒤이랑, 말하기는 브로카, 말 이해는 베르니케, 청각은 관자엽, 시각은 뒤통수엽!"
 },
 {
  "key": "6b8d3a256321",
  "text": "갑자기 자극이 들어와요!"
 },
 {
  "key": "f2164bf94731",
  "text": "척수가 어떻게 반응할지 5초 안에 골라 주세요."
 },
 {
  "key": "0d22b4221e9e",
  "text": "맞히면 척수 단면 위로 반사궁 신호가 흘러요."
 },
 {
  "key": "601b7a1af0db",
  "text": "반사는 뇌까지 가지 않고 척수에서 바로 처리돼요."
 },
 {
  "key": "09816b2c946c",
  "text": "신호를 따라 층마다 신호가 지나가는 쪽, 몸의 왼쪽, 오른쪽 절반, 을 눌러 경로를 그려요."
 },
 {
  "key": "b5813625bd77",
  "text": "어디서 반대쪽으로 건너가는지가 핵심!"
 },
 {
  "key": "b68a8bcdddc1",
  "text": "감각은 위로 올라가며, 운동 명령은 내려가며 반대쪽으로 교차해요."
 },
 {
  "key": "b2ebfc66339d",
  "text": "감각 신호가 시상에 도착해요!"
 },
 {
  "key": "b8b16f3df0e3",
  "text": "6초 안에 맞는 중계핵을 눌러서 대뇌겉질로 보내 주세요."
 },
 {
  "key": "2e4a175a70ad",
  "text": "시상은 후각을 뺀 거의 모든 감각이 대뇌로 가기 전에 거치는 관문이에요."
 },
 {
  "key": "a8b5f9cb7670",
  "text": "동작 명령에 맞는 뇌신경을 고르면 캐릭터가 그대로 움직여요!"
 },
 {
  "key": "2f920a424778",
  "text": "눈을 움직이는 건 III, IV, VI, 표정은 VII, 씹기는 V, 혀는 XII, 어깨는 XI!"
 },
 {
  "key": "bd7a97072772",
  "text": "널이 스타 제로원을 계속 흔들어요, 운동실조 흉내."
 },
 {
  "key": "38ef34477d90",
  "text": "◀ ▶를 눌러 가운데 초록 구역에 15초 동안 최대한 오래 머물러 주세요."
 },
 {
  "key": "2e70c03a117d",
  "text": "60% 이상이면 성공!"
 },
 {
  "key": "743c6affbbcb",
  "text": "신호가 랑비에 결절에 닿아 빛나는 순간 [재생성!"
 },
 {
  "key": "4763c8aa2973",
  "text": "]을 눌러 활동전위를 다시 만들어 주세요."
 },
 {
  "key": "343fcc4ddaae",
  "text": "금빛 수초 구간은 빠르게 건너뛰어요."
 },
 {
  "key": "cb2bf1810892",
  "text": "수초는 절연체라 전류가 빨리 지나가고, 결절에서만 활동전위가 다시 만들어져요."
 },
 {
  "key": "c2c955f6f312",
  "text": "활동전위가 처음 발생하는 '방아쇠 영역'은 어디일까요?"
 },
 {
  "key": "1182a17f0ff7",
  "text": "축삭둔덕과 축삭 시작분절에는 전압개폐 나트륨 이온 통로가 밀집해 있어 가장 먼저 역치에 도달합니다."
 },
 {
  "key": "b64d69b82816",
  "text": "가지돌기, 세포체에서 가중된 국소전위가 이곳에서 역치를 넘으면 활동전위가 시작됩니다."
 },
 {
  "key": "aef55f5df029",
  "text": "가지돌기는 시냅스 입력을 받아 국소, 등급, 전위를 만드는 곳입니다."
 },
 {
  "key": "3714c1fbcae8",
  "text": "전압개폐 나트륨 이온 통로 밀도가 낮아 보통 활동전위의 시작점이 아닙니다."
 },
 {
  "key": "8752922fd8a5",
  "text": "휴지막전위, 약 마이너스 70 밀리볼트, 의 뉴런이 역치, 약 마이너스 55 밀리볼트, 에 도달했습니다."
 },
 {
  "key": "c284e58fe93c",
  "text": "다음 단계는?"
 },
 {
  "key": "6c3d681ff636",
  "text": "역치에 도달하면 전압개폐 나트륨 이온 통로가 열려 나트륨 이온가 세포 안으로 빠르게 유입되고, 막전위가 플러스 30 밀리볼트 부근까지 상승합니다, 탈분극."
 },
 {
  "key": "e361e2564901",
  "text": "재분극은 정점 이후 칼륨 이온 유출로 막전위가 다시 낮아지는 단계입니다."
 },
 {
  "key": "192c76218afd",
  "text": "아직 탈분극이 일어나지 않았어요."
 },
 {
  "key": "4a3968be0209",
  "text": "과분극은 재분극 뒤에 오는 마지막 단계입니다."
 },
 {
  "key": "736628f922a0",
  "text": "막전위가 플러스 30 밀리볼트 정점에 도달했습니다."
 },
 {
  "key": "e76b21a11dc3",
  "text": "정점에서 나트륨 이온 통로는 불활성화되고, 늦게 열리는 전압개폐 칼륨 이온 통로를 통해 칼륨 이온가 밖으로 나가면서 막전위가 다시 낮아집니다, 재분극."
 },
 {
  "key": "01a274417e9d",
  "text": "정점에서는 나트륨 이온 통로가 불활성화되어 나트륨 이온 유입이 멈춥니다."
 },
 {
  "key": "808c375059d2",
  "text": "과분극은 재분극이 지나쳐서 생기는 단계로, 재분극 다음에 옵니다."
 },
 {
  "key": "cbee424b9570",
  "text": "재분극 후 막전위가 휴지막전위보다 더 낮아지는 단계는?"
 },
 {
  "key": "34719407f0e7",
  "text": "전압개폐 칼륨 이온 통로가 천천히 닫히기 때문에 칼륨 이온 유출이 잠시 더 이어져 막전위가 마이너스 70 밀리볼트보다 낮아집니다."
 },
 {
  "key": "3c4f288cf6fa",
  "text": "이 시기는 상대 불응기에 해당해 새 활동전위가 일어나기 어렵습니다."
 },
 {
  "key": "51ca45cdd304",
  "text": "탈분극은 막전위가 올라가는 단계입니다."
 },
 {
  "key": "05657a12c0c9",
  "text": "역치 전위는 활동전위가 시작되는 기준값, 약 마이너스 55 밀리볼트, 이지 하나의 단계가 아닙니다."
 },
 {
  "key": "ce9a68cc68cf",
  "text": "활동전위가 지나간 뒤, 세포 안팎의 나트륨 이온, 칼륨 이온 농도 기울기를 장기적으로 유지하는 것은?"
 },
 {
  "key": "8aa2e5618e26",
  "text": "나트륨 칼륨 ATPase는 ATP를 사용해 나트륨 이온 3개를 밖으로, 칼륨 이온 2개를 안으로 운반하여 농도 기울기를 유지합니다."
 },
 {
  "key": "1fff0c3f893d",
  "text": "한 번의 재분극 자체는 칼륨 이온 유출로 일어나고, 펌프는 기울기를 장기적으로 유지합니다."
 },
 {
  "key": "93f025d43448",
  "text": "전압개폐 칼슘 이온 통로는 축삭종말에서 전달물질 방출을 일으킵니다."
 },
 {
  "key": "07951641efac",
  "text": "리간드개폐 통로는 신경전달물질 결합으로 열리는 시냅스후막의 통로입니다."
 },
 {
  "key": "da6a9666c66b",
  "text": "말이집, 수초, 축삭에서 활동전위가 '새로 생성'되는 곳은?"
 },
 {
  "key": "c39c5c5880d6",
  "text": "수초는 절연체 역할을 하여 마디사이에서는 전류가 빠르게 수동 전도되고, 전압개폐 나트륨 이온 통로가 밀집한 랑비에 결절에서 활동전위가 다시 생성됩니다."
 },
 {
  "key": "b28b01fcf8d5",
  "text": "신호가 순간이동하는 것이 아니라 결절마다 재생성되며 '도약하듯' 전도되어 속도가 빨라집니다."
 },
 {
  "key": "685b0e0c81bb",
  "text": "마디사이는 수초로 절연되어 있고 나트륨 이온 통로가 적어 활동전위가 생성되지 않습니다."
 },
 {
  "key": "305b3a40fe4d",
  "text": "활동전위는 축삭을 따라 결절마다 재생성되며 전파됩니다."
 },
 {
  "key": "47db8542531d",
  "text": "축삭종말은 신경전달물질을 방출하는 곳입니다."
 },
 {
  "key": "8bd20db2ec46",
  "text": "중추신경계에서 축삭의 수초를 형성하는 세포는?"
 },
 {
  "key": "ce22c2f82048",
  "text": "중추신경계의 수초는 희소돌기아교세포가 만들며, 세포 하나가 여러 축삭에 수초를 형성할 수 있습니다."
 },
 {
  "key": "e1ac5d69b4c4",
  "text": "말초신경계에서는 슈반세포가 수초를 만듭니다."
 },
 {
  "key": "874a00cc3661",
  "text": "다발경화증은 중추신경계의 대표적인 탈수초 질환입니다."
 },
 {
  "key": "538943f8ed36",
  "text": "슈반세포는 말초신경계의 수초를 형성합니다."
 },
 {
  "key": "2a21de7a2500",
  "text": "별아교세포는 혈액뇌장벽 유지, 이온, 신경전달물질 환경 조절을 담당하며 수초를 만들지 않습니다."
 },
 {
  "key": "82d5522ef46f",
  "text": "화학적 시냅스 전달 순서대로 터치하세요!"
 },
 {
  "key": "c112fbaee18f",
  "text": "축삭종말이 탈분극되면 전압개폐 칼슘 이온 통로가 열리고, 유입된 칼슘 이온가 소포의 세포외배출을 일으켜 신경전달물질이 방출됩니다."
 },
 {
  "key": "37f2d32ede97",
  "text": "전달물질은 시냅스틈새를 확산해 시냅스후막 수용체에 결합하고, 이온통로가 열려 시냅스후전위가 생깁니다."
 },
 {
  "key": "0931e59bf6b2",
  "text": "흥분성 전달물질 글루탐산이 수용체에 결합해 나트륨 이온가 유입되었습니다."
 },
 {
  "key": "d58e9e0fce4d",
  "text": "시냅스후막에 생기는 전위는?"
 },
 {
  "key": "c345d218400b",
  "text": "양이온 유입은 시냅스후막을 탈분극시켜 역치에 가까워지게 하는 EPSP를 만듭니다."
 },
 {
  "key": "ba738db50ccb",
  "text": "반대로 GABA, 글라이신이 염소 이온 유입이나 칼륨 이온 유출을 일으키면 과분극성 IPSP가 됩니다."
 },
 {
  "key": "b8bafe8bb88c",
  "text": "IPSP는 염소 이온 유입이나 칼륨 이온 유출로 막을 과분극시킬 때 생깁니다."
 },
 {
  "key": "45e18c3b9142",
  "text": "나트륨 이온 유입은 탈분극입니다."
 },
 {
  "key": "1680c2c7bcbe",
  "text": "나는 스타 제로원, 뉴런을 타고 달리는 신경 신호야."
 },
 {
  "key": "742d5e0ebddb",
  "text": "내가 끝까지 달린 길은 다시 이어져!"
 },
 {
  "key": "7fc478067eca",
  "text": "첫 임무는 뉴런 하나를 처음부터 끝까지 달리는 거야."
 },
 {
  "key": "9be75213955f",
  "text": "가지돌기에서 신호를 모으고, 세포체와 축삭을 지나 시냅스까지!"
 },
 {
  "key": "4dcea0e77ac6",
  "text": "문제를 맞히면 길이 열리고, 틀리면 돌아가야 해."
 },
 {
  "key": "ef5c56f739e1",
  "text": "장애물을 피하면서 신호를 끊기지 않게 전달하자."
 },
 {
  "key": "69ab5ae3c6e2",
  "text": "출발!"
 },
 {
  "key": "1e385e98a179",
  "text": "여기는 축삭 시작분절!"
 },
 {
  "key": "ada210e682c2",
  "text": "게이트마다 활동전위의 '다음 단계' 차선으로 들어가자."
 },
 {
  "key": "84f25d56fac9",
  "text": "초록 복구 오브를 모으고, 마지막 게이트에서 수초를 되살리자!"
 },
 {
  "key": "2af53a982146",
  "text": "시냅스후 뉴런으로 신호 전달 성공!"
 },
 {
  "key": "73ee5f938702",
  "text": "결승선까지 전력 질주!"
 },
 {
  "key": "595698282901",
  "text": "근육으로 명령을 보내는 운동신경세포의 세포체가 모여 있는 척수 회색질은?"
 },
 {
  "key": "872326fb29d3",
  "text": "척수 회색질의 앞뿔에는 아래운동신경세포, 알파운동신경세포, 의 세포체가 있습니다."
 },
 {
  "key": "d8c1c55a3107",
  "text": "뒤뿔은 감각 정보를 받는 곳입니다."
 },
 {
  "key": "74b9bcc3535f",
  "text": "뒤뿔은 뒤뿌리로 들어온 감각 정보를 받아 중계하는 곳입니다."
 },
 {
  "key": "b679b1e71ddc",
  "text": "몸의 감각을 전달하는 1차 감각신경세포의 세포체가 모여 있는 곳은?"
 },
 {
  "key": "029dda00843b",
  "text": "1차 감각신경세포는 척수 밖 뒤뿌리신경절에 세포체가 있습니다."
 },
 {
  "key": "34cf087b0ab1",
  "text": "한 가지는 말초로, 다른 가지는 뒤뿌리를 통해 척수로 들어갑니다."
 },
 {
  "key": "b5b17f988e37",
  "text": "가쪽뿔, 가슴, 위허리 분절, 은 교감신경의 신경절이전신경세포가 있는 곳입니다."
 },
 {
  "key": "18e2c85e825a",
  "text": "앞뿔은 운동신경세포의 세포체가 있는 곳입니다."
 },
 {
  "key": "8bdc86d41204",
  "text": "무릎힘줄을 두드려 넙다리네갈래근이 갑자기 늘어날 때, 늘어남을 감지하는 수용기는?"
 },
 {
  "key": "34c6591d76c5",
  "text": "근육방추는 근육의 길이 변화, 늘어남, 를 감지하며, 신장반사, 무릎반사, 의 수용기입니다."
 },
 {
  "key": "8d400d319a37",
  "text": "골지힘줄기관은 힘줄에 걸리는 장력을 감지합니다."
 },
 {
  "key": "0f0f777608a7",
  "text": "자유신경종말은 주로 통증과 온도를 감지합니다."
 },
 {
  "key": "96ccb403f732",
  "text": "무릎반사, 신장반사, 는 척수에서 몇 개의 시냅스를 거칠까요?"
 },
 {
  "key": "cd274ee17195",
  "text": "근육방추의 감각신경이 척수 앞뿔의 운동신경세포에 직접 시냅스하는 단일시냅스 반사입니다."
 },
 {
  "key": "f2653d9892d1",
  "text": "그래서 매우 빠릅니다."
 },
 {
  "key": "7d282f245c3c",
  "text": "반사궁에는 반드시 감각신경과 운동신경 사이의 시냅스가 있습니다."
 },
 {
  "key": "942577960c19",
  "text": "굽힘반사처럼 사이신경세포를 거치는 반사는 다시냅스 반사입니다."
 },
 {
  "key": "e76404eb8517",
  "text": "무릎반사는 아닙니다."
 },
 {
  "key": "6f1cb3c1fdcb",
  "text": "반사궁의 올바른 순서는?"
 },
 {
  "key": "0430b47ad587",
  "text": "반사궁은 수용기 , 그다음 감각, 들, 신경 , 그다음 척수의 중추, 사이신경세포, 그다음 운동, 날, 신경 , 그다음 효과기, 근육, 샘, 순서입니다."
 },
 {
  "key": "edf74f3971c1",
  "text": "감각신경과 운동신경의 순서가 바뀌었습니다."
 },
 {
  "key": "53748b982229",
  "text": "정보는 감각신경을 따라 척수로 들어가고, 운동신경을 따라 나옵니다."
 },
 {
  "key": "d54d8257acd3",
  "text": "신장반사 때 수축하는 근육의 반대편 길항근이 이완되도록 하는 기전은?"
 },
 {
  "key": "91420aec3a55",
  "text": "근육방추 감각신경은 억제성 사이신경세포를 통해 길항근의 운동신경세포를 억제합니다."
 },
 {
  "key": "28a7725715d2",
  "text": "이 상호억제 덕분에 동작이 부드러워집니다."
 },
 {
  "key": "8421be079433",
  "text": "탈수초는 전도 장애이지 정상 반사 기전이 아닙니다."
 },
 {
  "key": "fbfa65008f54",
  "text": "소포 고갈은 반복 자극에 따른 피로 현상으로, 상호억제와 다릅니다."
 },
 {
  "key": "0eccdd04c6c4",
  "text": "압정을 밟으면 그 다리는 굽히고 반대쪽 다리는 펴서 몸을 지탱한다."
 },
 {
  "key": "0f942e6c92c8",
  "text": "이 반사는?"
 },
 {
  "key": "eaf2cfc5e4ae",
  "text": "통증 자극은 다시냅스 경로로 같은 쪽 굽힘근을 수축시키고, 굽힘반사, 척수 반대편으로 건너가 반대쪽 폄근을 수축시킵니다, 교차폄반사."
 },
 {
  "key": "350f6de7e1cd",
  "text": "신장반사는 근육이 늘어날 때 같은 근육이 수축하는 반사입니다."
 },
 {
  "key": "3fc579e99723",
  "text": "골지힘줄반사는 장력이 클 때 근육을 이완시키는 반사입니다."
 },
 {
  "key": "97b1d7d85fba",
  "text": "반사궁을 순서대로 이어서 빠른 회로를 복구하자!"
 },
 {
  "key": "cbfb99d59441",
  "text": "반사 회로 복구 완료!"
 },
 {
  "key": "3a4fe813b6d6",
  "text": "결승선까지!"
 },
 {
  "key": "e17e30a5db82",
  "text": "미세한 촉각, 진동, 위치감각, 고유감각, 을 대뇌로 전달하는 경로는?"
 },
 {
  "key": "5cd916e2c23b",
  "text": "뒤기둥-안쪽섬유띠계는 미세촉각, 진동감각, 의식적 고유감각을 전달합니다."
 },
 {
  "key": "455cae3b7522",
  "text": "앞가쪽계는 통증, 온도, 거친 촉각을 전달합니다."
 },
 {
  "key": "b6e1eeb87903",
  "text": "뒤기둥-안쪽섬유띠계의 2차 신경섬유가 반대쪽으로 교차하는 곳은?"
 },
 {
  "key": "6f916279b4f0",
  "text": "1차 신경은 같은 쪽 뒤기둥을 따라 올라가 숨뇌의 널판핵, 쐐기핵에서 시냅스합니다."
 },
 {
  "key": "5fcdfb53bbc7",
  "text": "2차 신경은 속활꼴섬유로 교차해 안쪽섬유띠를 이룹니다."
 },
 {
  "key": "74e54aaa33f9",
  "text": "척수에서 곧바로 교차하는 것은 앞가쪽계입니다."
 },
 {
  "key": "028a22acdc3f",
  "text": "중간뇌가 아니라 숨뇌에서 교차합니다."
 },
 {
  "key": "9213957dda88",
  "text": "통증, 온도감각을 전달하는 앞가쪽계, 척수시상로, 가 교차하는 곳은?"
 },
 {
  "key": "2ab60d196277",
  "text": "통증, 온도 신경은 뒤뿔에서 시냅스한 뒤 곧 앞흰질맞교차를 지나 반대쪽에서 올라갑니다."
 },
 {
  "key": "5c7c9fd1ebc2",
  "text": "그래서 척수 반쪽 손상 때 반대쪽 통증, 온도감각이 사라집니다."
 },
 {
  "key": "3d5dd5d8d084",
  "text": "시상은 중계 장소이지 교차 위치가 아닙니다."
 },
 {
  "key": "d043ad6fffc2",
  "text": "숨뇌에서 교차하는 것은 뒤기둥-안쪽섬유띠계입니다."
 },
 {
  "key": "204d9a18102a",
  "text": "의식되지 않는 고유감각을 소뇌로 보내 자세와 움직임을 조절하게 하는 경로는?"
 },
 {
  "key": "f92c4a7331c2",
  "text": "척수소뇌로는 근육, 관절의 고유감각 정보를 의식에 도달하지 않은 채 소뇌로 보냅니다."
 },
 {
  "key": "5ad83a913999",
  "text": "겉질척수로는 내려가는 운동 경로입니다."
 },
 {
  "key": "4b860f67f1bf",
  "text": "그물척수로는 자세, 근긴장을 조절하는 내림로입니다."
 },
 {
  "key": "7d2c4ecaa703",
  "text": "손가락을 섬세하게 움직이는 수의운동 명령을 척수로 전달하는 주된 경로는?"
 },
 {
  "key": "8a13282a9c7a",
  "text": "겉질척수로는 일차운동겉질에서 시작해 척수 앞뿔의 운동신경세포로 수의운동 명령을 전달합니다."
 },
 {
  "key": "51dc9b672f2b",
  "text": "앞가쪽계는 감각, 통증, 온도, 을 올려 보내는 오름로입니다."
 },
 {
  "key": "e478e83e71cf",
  "text": "가쪽겉질척수로 섬유가 대부분 반대쪽으로 교차하는 곳은?"
 },
 {
  "key": "2daa01af9188",
  "text": "겉질척수로 섬유의 대부분, 약 85에서 90%, 이 숨뇌 아래쪽 피라미드 교차에서 반대쪽으로 넘어가 가쪽겉질척수로가 됩니다."
 },
 {
  "key": "75231b9a3b6d",
  "text": "앞겉질척수로 일부만 척수 분절에서 교차합니다."
 },
 {
  "key": "6fb546036545",
  "text": "시상은 운동 내림로의 교차 위치가 아닙니다."
 },
 {
  "key": "ac2587735232",
  "text": "몸이 기울어질 때 안뜰신경핵에서 척수로 내려가 폄근을 조절해 균형을 잡게 하는 경로는?"
 },
 {
  "key": "894cd464dd78",
  "text": "안뜰척수로는 안뜰신경핵에서 시작해 주로 폄근, 항중력근, 을 촉진하여 자세와 균형을 유지합니다."
 },
 {
  "key": "64476199c1d7",
  "text": "겉질숨뇌로는 뇌신경 운동핵으로 가는 경로입니다."
 },
 {
  "key": "52aa7b1cbbd6",
  "text": "척수시상로는 감각 오름로입니다."
 },
 {
  "key": "63fd01ed85b7",
  "text": "교차 위치를 정확히 알아야 길을 잃지 않아!"
 },
 {
  "key": "2c9a791f3588",
  "text": "오름로, 내림로 정비 완료!"
 },
 {
  "key": "591a4cbcbb33",
  "text": "도파민 신경세포가 많아 손상되면 파킨슨병과 관련되는 중간뇌 구조는?"
 },
 {
  "key": "8ca7a7189e09",
  "text": "중간뇌의 흑색질, 치밀부, 에는 도파민 신경세포가 있으며, 바닥핵으로 투사합니다."
 },
 {
  "key": "0e950feca084",
  "text": "이 세포가 소실되면 파킨슨병이 생깁니다."
 },
 {
  "key": "03b3b15c298e",
  "text": "올리브는 숨뇌에 있으며 소뇌와 연결됩니다."
 },
 {
  "key": "60c1fa9722e8",
  "text": "위둔덕은 시각 반사에 관여합니다."
 },
 {
  "key": "e91d9a308616",
  "text": "갑자기 나타난 물체 쪽으로 눈과 머리를 돌리는 시각 반사에 관여하는 중간뇌 구조는?"
 },
 {
  "key": "50028eee1919",
  "text": "중간뇌 덮개의 위둔덕은 시각 정보를 받아 눈, 머리의 반사적 방향 전환에 관여합니다."
 },
 {
  "key": "16b4cbb6eaff",
  "text": "적색핵은 운동 협응과 관련된 핵입니다."
 },
 {
  "key": "404d25d40fa8",
  "text": "아래둔덕은 청각 경로의 중계 장소입니다."
 },
 {
  "key": "ab953bbf2ec6",
  "text": "청각 정보가 시상, 안쪽무릎체, 으로 가기 전에 중계되는 중간뇌 구조는?"
 },
 {
  "key": "314856538078",
  "text": "아래둔덕은 청각 경로의 중요한 중계 장소로, 이후 안쪽무릎체를 거쳐 청각겉질로 갑니다."
 },
 {
  "key": "34d1e65c291d",
  "text": "셋째뇌실과 넷째뇌실을 잇는 중간뇌의 좁은 통로는?"
 },
 {
  "key": "45c999b75ef5",
  "text": "중뇌수도관, 대뇌수도관, 은 중간뇌를 지나 셋째뇌실과 넷째뇌실을 연결합니다."
 },
 {
  "key": "a102e181edc8",
  "text": "막히면 폐쇄성 수두증이 생길 수 있습니다."
 },
 {
  "key": "8b145cbcac8e",
  "text": "중심관은 척수 안의 통로입니다."
 },
 {
  "key": "55fec62137a4",
  "text": "뇌실사이구멍은 가쪽뇌실과 셋째뇌실을 연결합니다."
 },
 {
  "key": "e00f8e4ab126",
  "text": "중간뇌에 운동핵이 있는 뇌신경은?"
 },
 {
  "key": "12a074750586",
  "text": "중간뇌에는 눈돌림신경과 도르래신경의 핵이 있습니다."
 },
 {
  "key": "6bfca8de4b83",
  "text": "5번 에서 8번 은 주로 다리뇌, 9번 에서 12번 는 주로 숨뇌와 관련됩니다."
 },
 {
  "key": "8542d2d61c23",
  "text": "VII, 8번 신경핵은 주로 다리뇌, 다리뇌-숨뇌 경계, 에 있습니다."
 },
 {
  "key": "766000f16c48",
  "text": "IX, 10번 신경핵은 숨뇌에 있습니다."
 },
 {
  "key": "b8fcbff7c3d8",
  "text": "가장 굵은 소뇌다리, 중간소뇌다리, 로 소뇌와 연결되는 뇌줄기 부분은?"
 },
 {
  "key": "197446220127",
  "text": "다리뇌의 다리뇌핵에서 나온 섬유가 중간소뇌다리를 이루어 반대쪽 소뇌로 갑니다."
 },
 {
  "key": "d4f6e76746f8",
  "text": "대뇌겉질의 정보를 소뇌로 전달하는 중요한 통로입니다."
 },
 {
  "key": "d12345065ce6",
  "text": "숨뇌는 주로 아래소뇌다리로 소뇌와 연결됩니다."
 },
 {
  "key": "62353979ced7",
  "text": "호흡과 심장 박동, 혈압을 조절하는 생명 중추가 있는 곳은?"
 },
 {
  "key": "278ccaa48a89",
  "text": "숨뇌에는 호흡 중추와 심혈관 중추가 있어 생명 유지에 필수적입니다."
 },
 {
  "key": "6157c9421560",
  "text": "중간뇌 덮개는 시각, 청각 반사에 관여합니다."
 },
 {
  "key": "f9279d6f5a18",
  "text": "소뇌 벌레는 몸통의 균형에 관여합니다."
 },
 {
  "key": "2706371b7082",
  "text": "생명 중추를 널로부터 지키자!"
 },
 {
  "key": "f675809f2f98",
  "text": "뇌줄기 회로 안정화!"
 },
 {
  "key": "95d12de3c55f",
  "text": "결승으로!"
 },
 {
  "key": "b9304bf5e4b8",
  "text": "소뇌의 주된 기능은?"
 },
 {
  "key": "6d821184ebcb",
  "text": "소뇌는 움직임의 정확도와 타이밍을 조절하고, 균형과 자세를 유지하며, 운동학습에 관여합니다."
 },
 {
  "key": "6195e3a6880c",
  "text": "시각 인식은 뒤통수엽 시각겉질의 기능입니다."
 },
 {
  "key": "4c0dbd906f1b",
  "text": "수의운동 명령은 주로 일차운동겉질에서 시작됩니다."
 },
 {
  "key": "3f345c2eba7d",
  "text": "소뇌겉질의 유일한 출력 신경세포이며 억제성인 세포는?"
 },
 {
  "key": "77908e049239",
  "text": "조롱박세포는 소뇌겉질의 유일한 출력세포로, GABA를 사용해 소뇌핵을 억제합니다."
 },
 {
  "key": "176cb8f3a69f",
  "text": "과립세포는 흥분성이며 평행섬유를 통해 조롱박세포에 입력합니다."
 },
 {
  "key": "fbf5bc1b8938",
  "text": "별세포는 겉질 안의 억제성 사이신경세포입니다."
 },
 {
  "key": "1e3f2ef1a668",
  "text": "다리뇌에서 오는 입력이 지나는, 가장 굵은 소뇌다리는?"
 },
 {
  "key": "47861dfa107a",
  "text": "중간소뇌다리는 다리뇌핵에서 오는 섬유로 이루어진 가장 굵은 소뇌다리이며 입력 전용입니다."
 },
 {
  "key": "1be8ff480701",
  "text": "위소뇌다리는 주로 소뇌의 출력이 나가는 통로입니다."
 },
 {
  "key": "3e0882751118",
  "text": "소뇌핵에서 나온 출력이 주로 지나 중간뇌, 시상으로 가는 소뇌다리는?"
 },
 {
  "key": "b4a64f3bbb0a",
  "text": "소뇌의 출력은 주로 위소뇌다리를 지나 적색핵과 시상으로 갑니다."
 },
 {
  "key": "f313216818bd",
  "text": "중간소뇌다리는 입력 전용입니다."
 },
 {
  "key": "04145a3dc2cf",
  "text": "아래소뇌다리는 척수, 숨뇌에서 오는 입력이 주로 지납니다."
 },
 {
  "key": "6aa6e145f220",
  "text": "소뇌 벌레, 충부, 가 손상되면 주로 나타나는 증상은?"
 },
 {
  "key": "0fd3a5ab87c0",
  "text": "소뇌 벌레는 몸통의 균형과 자세를 조절합니다."
 },
 {
  "key": "3c45cc61edd2",
  "text": "손상되면 다리를 넓게 벌리고 비틀거리는 몸통 운동실조가 나타납니다."
 },
 {
  "key": "7f7c6b1d7728",
  "text": "편마비는 겉질척수로 손상의 증상입니다."
 },
 {
  "key": "d8d5ab493c4e",
  "text": "실어증은 대뇌 언어 영역의 손상으로 생깁니다."
 },
 {
  "key": "284687f1d7f3",
  "text": "손을 목표로 뻗을 때 목표에 가까워질수록 떨림이 심해지는 소뇌 징후는?"
 },
 {
  "key": "d20b49a66fb6",
  "text": "의도떨림은 움직이는 동안, 특히 목표에 가까워질 때 심해지는 떨림으로 소뇌 병변의 특징입니다."
 },
 {
  "key": "8e0f14f8cbe0",
  "text": "안정떨림은 쉬고 있을 때 나타나며 파킨슨병의 특징입니다."
 },
 {
  "key": "52de4ceb8c98",
  "text": "무도증은 불규칙한 춤추는 듯한 움직임으로 바닥핵 질환, 헌팅턴병 등, 과 관련됩니다."
 },
 {
  "key": "8b2c6be5084a",
  "text": "드리프트로 균형을 잡으면서 협응 회로를 복구하자!"
 },
 {
  "key": "88576760c502",
  "text": "균형 회로 복구!"
 },
 {
  "key": "023ccb9c945a",
  "text": "마지막 질주!"
 },
 {
  "key": "d9aadb767e7c",
  "text": "후각을 제외한 대부분의 감각 정보를 대뇌겉질로 중계하는 곳은?"
 },
 {
  "key": "e5bb2e46a64a",
  "text": "시상은 후각을 제외한 감각 정보와 운동 회로 정보를 대뇌겉질로 중계하는 관문입니다."
 },
 {
  "key": "e1cf430fb6f7",
  "text": "시상하부는 항상성과 내분비, 자율신경을 조절합니다."
 },
 {
  "key": "421d2b69bc7b",
  "text": "몸, 목 아래, 의 촉각, 통증 정보가 중계되는 시상핵은?"
 },
 {
  "key": "87071c8648ea",
  "text": "몸의 감각은 시상의 배쪽뒤가쪽핵에서, 얼굴의 감각은 배쪽뒤안쪽핵에서 중계되어 일차몸감각겉질로 갑니다."
 },
 {
  "key": "526f8e8f88d5",
  "text": "가쪽무릎체는 시각 정보를 중계합니다."
 },
 {
  "key": "c4f5136b661f",
  "text": "안쪽무릎체는 청각 정보를 중계합니다."
 },
 {
  "key": "d2bc5cd3b4ae",
  "text": "시각로의 정보가 시각겉질로 가기 전에 중계되는 시상핵은?"
 },
 {
  "key": "a5fcc7729fae",
  "text": "시각 정보는 시상의 가쪽무릎체에서 중계되어 시각부챗살을 따라 일차시각겉질로 갑니다."
 },
 {
  "key": "d15638ebee30",
  "text": "배쪽앞핵은 바닥핵, 운동 회로와 관련됩니다."
 },
 {
  "key": "0798a58b6ff9",
  "text": "안쪽무릎체는 청각을 중계합니다."
 },
 {
  "key": "3f1f469d224d",
  "text": "체온, 배고픔, 갈증 등 항상성을 조절하는 곳은?"
 },
 {
  "key": "9408e27ef075",
  "text": "시상하부는 체온, 섭식, 수분 균형, 일주기 리듬 등 항상성을 조절하고 자율신경계와 내분비계를 통제합니다."
 },
 {
  "key": "b17878e49aa1",
  "text": "시상은 감각 정보를 중계하는 관문입니다."
 },
 {
  "key": "f847d930bfb6",
  "text": "시상하부와 깔때기로 연결되어 호르몬 분비를 조절받는 내분비샘은?"
 },
 {
  "key": "6406838664e8",
  "text": "시상하부는 깔때기, 누두, 로 연결된 뇌하수체를 통해 여러 내분비샘의 호르몬 분비를 조절합니다."
 },
 {
  "key": "d8974ae84749",
  "text": "부신은 뇌하수체 호르몬 등의 영향을 받지만 시상하부와 직접 연결되지 않습니다."
 },
 {
  "key": "a5f45d5b483a",
  "text": "이자는 혈당 등에 의해 주로 조절됩니다."
 },
 {
  "key": "0c420ce79a83",
  "text": "멜라토닌을 분비해 일주기 리듬에 관여하는 사이뇌 구조는?"
 },
 {
  "key": "a5c7904c1e6f",
  "text": "솔방울샘, 송과체, 은 어두울 때 멜라토닌을 분비하여 수면-각성 같은 일주기 리듬에 관여합니다."
 },
 {
  "key": "0d57630680b4",
  "text": "시각교차는 시신경 섬유가 교차하는 곳입니다."
 },
 {
  "key": "3e892be6d114",
  "text": "유두체는 기억 회로, 파페츠 회로, 와 관련됩니다."
 },
 {
  "key": "1010b8a779e9",
  "text": "시상은 관문, 시상하부는 항상성!"
 },
 {
  "key": "ef8db0dd8a73",
  "text": "헷갈리지 말자."
 },
 {
  "key": "d661e04d11e4",
  "text": "중계 기지 정상화!"
 },
 {
  "key": "18f792a177bd",
  "text": "수의운동 명령을 내보내는 일차운동겉질, 중심앞이랑, 은 어디에 있을까요?"
 },
 {
  "key": "74f1c2025fc6",
  "text": "중심고랑 바로 앞의 중심앞이랑, 이마엽, 이 일차운동겉질입니다."
 },
 {
  "key": "c39fd7b68175",
  "text": "여기서 시작한 겉질척수로가 숨뇌 피라미드에서 교차해 반대쪽 몸을 움직입니다."
 },
 {
  "key": "a77e3caee599",
  "text": "중심뒤이랑은 중심고랑 뒤의 일차몸감각겉질, 마루엽, 입니다."
 },
 {
  "key": "84d1fd98d42c",
  "text": "새발톱고랑 주변은 일차시각겉질, 뒤통수엽, 입니다."
 },
 {
  "key": "d0279000506e",
  "text": "왼쪽 대뇌 손상 후 말은 알아듣지만 말이 느리고 더듬거린다, 표현실어증."
 },
 {
  "key": "849038f3c125",
  "text": "손상 부위는?"
 },
 {
  "key": "5460de22de75",
  "text": "브로카 영역은 대부분 왼쪽 이마엽 아래이마이랑에 있으며 말의 산출을 담당합니다."
 },
 {
  "key": "75eca497676a",
  "text": "손상되면 이해는 비교적 보존되지만 비유창한 표현실어증이 생깁니다."
 },
 {
  "key": "51f5bcf7dabd",
  "text": "베르니케 영역 손상은 말은 유창하지만 이해가 어려운 수용실어증을 일으킵니다."
 },
 {
  "key": "fec413e8e095",
  "text": "일차시각겉질 손상은 시야 결손을 일으키며 실어증과 관련이 없습니다."
 },
 {
  "key": "6e6e605b266a",
  "text": "피부의 촉각, 통증 정보가 시상을 거쳐 도착하는 일차몸감각겉질, 중심뒤이랑, 은?"
 },
 {
  "key": "8d9665bb7024",
  "text": "중심고랑 바로 뒤의 중심뒤이랑, 마루엽, 이 일차몸감각겉질입니다."
 },
 {
  "key": "8c9e6c7f5276",
  "text": "몸 감각 정보는 시상의 배쪽뒤핵을 거쳐 이곳에 도착합니다."
 },
 {
  "key": "db8e771ec37d",
  "text": "이마엽의 중심앞이랑은 운동겉질입니다."
 },
 {
  "key": "6dc29f0a4d2e",
  "text": "감각이 아니라 운동 명령을 내보냅니다."
 },
 {
  "key": "2732467c1ab8",
  "text": "뒤통수엽은 시각 정보를 처리합니다."
 },
 {
  "key": "e4b2d81222c5",
  "text": "환자가 접시의 왼쪽 음식만 남기고, 왼쪽 공간을 무시한다, 반쪽무시."
 },
 {
  "key": "93ae3bca7303",
  "text": "가장 흔한 손상 부위는?"
 },
 {
  "key": "ddd9e1386214",
  "text": "공간 주의는 주로 오른쪽 마루엽이 담당합니다."
 },
 {
  "key": "dd9febe39487",
  "text": "오른쪽 마루엽이 손상되면 반대쪽, 왼쪽, 공간을 무시하는 반쪽무시가 흔히 나타납니다."
 },
 {
  "key": "643fa4da24db",
  "text": "왼쪽 이마엽 손상은 오른쪽 운동 약화나 표현실어증과 관련됩니다."
 },
 {
  "key": "7a6db125c8df",
  "text": "뒤통수엽 손상은 시야 결손을 일으키지만, 무시와는 다릅니다."
 },
 {
  "key": "33b91176b08a",
  "text": "소리 정보가 처음 도착하는 일차청각겉질은 어디에 있을까요?"
 },
 {
  "key": "4012bca883e2",
  "text": "일차청각겉질은 관자엽 위쪽의 가로관자이랑, 헤쉴이랑, 에 있습니다."
 },
 {
  "key": "a29e2cfb0502",
  "text": "청각 정보는 시상의 안쪽무릎체를 거쳐 이곳에 도착합니다."
 },
 {
  "key": "6615035185ca",
  "text": "뒤통수엽은 시각을 담당합니다."
 },
 {
  "key": "69b4447b4f61",
  "text": "마루엽은 몸감각과 공간 정보를 담당합니다."
 },
 {
  "key": "56e430b79080",
  "text": "말은 유창하지만 엉뚱한 단어가 섞이고, 남의 말을 이해하지 못한다, 수용실어증."
 },
 {
  "key": "2d10e69e24ee",
  "text": "베르니케 영역은 대부분 왼쪽 위관자이랑 뒤쪽에 있으며 언어 이해를 담당합니다."
 },
 {
  "key": "841ea1495b65",
  "text": "손상되면 유창하지만 의미가 맞지 않는 말과 이해 장애가 나타납니다."
 },
 {
  "key": "1ce168b92c6d",
  "text": "브로카 영역 손상은 이해는 비교적 보존되고 말이 비유창해집니다."
 },
 {
  "key": "67250cccb5f3",
  "text": "일차운동겉질 손상은 반대쪽 몸의 운동 약화를 일으킵니다."
 },
 {
  "key": "0c19d6b5ee1a",
  "text": "새로운 사실과 사건을 기억으로 만드는, 서술기억 형성, 데 중요한 해마는 어디에 있을까요?"
 },
 {
  "key": "6ca720a40afb",
  "text": "해마는 안쪽 관자엽에 있으며 새로운 서술기억 형성에 중요합니다."
 },
 {
  "key": "c27c56c77871",
  "text": "양쪽 해마가 손상되면 새로운 기억을 만들지 못하는 앞으로가는기억상실이 생길 수 있습니다."
 },
 {
  "key": "9ba80920c9a8",
  "text": "마루엽 위쪽은 몸감각 통합과 공간 처리에 관여합니다."
 },
 {
  "key": "f7c6b8994b50",
  "text": "이마엽 앞쪽은 계획, 판단 같은 실행기능을 담당합니다."
 },
 {
  "key": "74326b5c691e",
  "text": "시각 정보가 도착하는 일차시각겉질은 어디의 새발톱고랑 주변에 있을까요?"
 },
 {
  "key": "00e5698fa138",
  "text": "일차시각겉질은 뒤통수엽 안쪽면의 새발톱고랑 주변에 있습니다."
 },
 {
  "key": "05ac52113011",
  "text": "시각 정보는 시상의 가쪽무릎체에서 시각부챗살을 따라 이곳에 도착합니다."
 },
 {
  "key": "dc287843e0a0",
  "text": "관자엽은 청각과 언어 이해, 기억에 관여합니다."
 },
 {
  "key": "524d6b1f510a",
  "text": "일차시각겉질은 뒤통수엽에 있습니다."
 },
 {
  "key": "f80421de5c91",
  "text": "정보마다 올바른 대뇌엽으로 배달하자."
 },
 {
  "key": "82a91134a44f",
  "text": "이마엽부터 출발!"
 },
 {
  "key": "841c6d9a727b",
  "text": "뒤통수엽 지구 도착!"
 },
 {
  "key": "35caa3dcfb9d",
  "text": "시각 정보 배달 완료, 결승선까지 질주!"
 },
 {
  "key": "700fcadef431",
  "text": "눈알을 바깥쪽으로 돌리는 가쪽곧은근을 지배하는 신경은?"
 },
 {
  "key": "df49f0ce66b1",
  "text": "가쪽곧은근은 6번 갓돌림신경이 지배합니다."
 },
 {
  "key": "5e158562112d",
  "text": "손상되면 눈이 바깥으로 돌아가지 않아 복시가 생깁니다."
 },
 {
  "key": "570c3e3362c1",
  "text": "눈돌림신경은 대부분의 바깥눈근육과 위눈꺼풀올림근을 지배합니다."
 },
 {
  "key": "e48ede20206b",
  "text": "도르래신경은 위빗근만 지배합니다."
 },
 {
  "key": "fb3861cddbfa",
  "text": "위빗근을 지배하는 신경은?"
 },
 {
  "key": "1b8b026d39da",
  "text": "위빗근은 4번 도르래신경이 지배합니다."
 },
 {
  "key": "859742b39102",
  "text": "도르래신경은 뇌줄기 뒤쪽에서 나오는 유일한 뇌신경입니다."
 },
 {
  "key": "06e0e7efe640",
  "text": "눈돌림신경은 위빗근과 가쪽곧은근을 제외한 바깥눈근육을 지배합니다."
 },
 {
  "key": "b064ae3dfee0",
  "text": "갓돌림신경은 가쪽곧은근을 지배합니다."
 },
 {
  "key": "24a4ffb7e423",
  "text": "얼굴 표정근을 움직이는 운동신경은?"
 },
 {
  "key": "45de3b74889c",
  "text": "얼굴 표정근은 7번 얼굴신경이 지배합니다."
 },
 {
  "key": "b3897cb228cb",
  "text": "손상되면 같은 쪽 얼굴 전체가 마비될 수 있습니다, 벨마비."
 },
 {
  "key": "49c316bf797f",
  "text": "삼차신경은 얼굴의 감각과 씹기근육을 담당합니다."
 },
 {
  "key": "878f58852435",
  "text": "얼굴 피부의 감각을 담당하고 씹기근육을 지배하는 혼합신경은?"
 },
 {
  "key": "6a275884fc94",
  "text": "삼차신경은 세 가지, 눈, 위턱, 아래턱신경, 로 얼굴 감각을 담당하고, 아래턱신경으로 씹기근육을 지배합니다."
 },
 {
  "key": "dff595c1c108",
  "text": "얼굴신경은 표정근과 혀 앞 2, 3의 미각 등을 담당합니다."
 },
 {
  "key": "9b4d87948a14",
  "text": "혀밑신경은 혀 근육을 지배합니다."
 },
 {
  "key": "eef0bf6f50d0",
  "text": "순수한 감각신경으로만 이루어진 뇌신경 묶음은?"
 },
 {
  "key": "06d6d158eb6a",
  "text": "후각신경, 시각신경, 속귀신경은 감각신경입니다."
 },
 {
  "key": "b5f98f312cda",
  "text": "III, IV, 6번 는 눈 운동을 담당하는 운동신경입니다."
 },
 {
  "key": "5796873309db",
  "text": "V, VII, 9번 는 감각과 운동이 섞인 혼합신경입니다."
 },
 {
  "key": "6126539967c3",
  "text": "혀를 내밀면 한쪽으로 치우친다."
 },
 {
  "key": "c6203387e19d",
  "text": "손상된 신경은?"
 },
 {
  "key": "a5028c71cfd8",
  "text": "혀밑신경이 손상되면 같은 쪽 혀근육이 약해져서, 혀를 내밀 때 손상된 쪽으로 치우칩니다."
 },
 {
  "key": "93ade7705b24",
  "text": "혀인두신경은 혀 뒤 1, 3의 감각, 미각과 인두를 담당하며 혀 운동을 지배하지 않습니다."
 },
 {
  "key": "721dfcfa9a15",
  "text": "가슴과 배의 내장에 부교감신경을 보내는 뇌신경은?"
 },
 {
  "key": "f9c8c852fc9a",
  "text": "미주신경은 심장, 폐, 대부분의 소화관에 부교감신경을 보내고, 인두, 후두 근육도 지배합니다."
 },
 {
  "key": "3720d8d267cf",
  "text": "더부신경은 목빗근과 등세모근을 지배합니다."
 },
 {
  "key": "302bb8da5de9",
  "text": "혀인두신경의 부교감 섬유는 귀밑샘으로 갑니다."
 },
 {
  "key": "0d8438cf1a9a",
  "text": "어깨를 으쓱하는 등세모근과 고개를 돌리는 목빗근을 지배하는 신경은?"
 },
 {
  "key": "318ac1d78cf3",
  "text": "미주신경은 인두, 후두 근육과 내장을 담당합니다."
 },
 {
  "key": "e7401c4345f4",
  "text": "1번 부터 12번 까지, 정확한 포털로 신호를 보내자!"
 },
 {
  "key": "9422fb15fe19",
  "text": "뇌신경 포털 전부 연결!"
 },
 {
  "key": "647da73a8cfb",
  "text": "널 진단 1: 갑자기 오른쪽 팔, 다리의 힘이 빠지고 오른쪽 얼굴 아래쪽이 마비되었다."
 },
 {
  "key": "dad7e9bc5be6",
  "text": "병변으로 가장 알맞은 곳은?"
 },
 {
  "key": "af8f18c18783",
  "text": "겉질척수로는 숨뇌의 피라미드 교차에서 반대쪽으로 넘어갑니다."
 },
 {
  "key": "5fde0d832823",
  "text": "그래서 교차보다 위, 대뇌, 의 병변은 반대쪽 몸을 마비시킵니다."
 },
 {
  "key": "5088e10e9e3c",
  "text": "얼굴 아래쪽만 마비되는 것은 위운동신경세포, 겉질숨뇌로, 손상의 특징입니다."
 },
 {
  "key": "f897f8ae3e77",
  "text": "오른쪽 대뇌 병변은 왼쪽 몸의 마비를 일으킵니다."
 },
 {
  "key": "5a5ed8b61183",
  "text": "소뇌 병변은 마비보다 같은 쪽의 협응 장애, 운동실조, 를 일으킵니다."
 },
 {
  "key": "26e24290cce2",
  "text": "널 진단 2: 양쪽 눈 모두 왼쪽 시야 절반이 보이지 않는다, 왼쪽 동측반맹."
 },
 {
  "key": "79b10af1798e",
  "text": "병변은?"
 },
 {
  "key": "8ca2986d0a9b",
  "text": "시각교차 뒤에서는 각 시각로가 반대쪽 시야를 담당합니다."
 },
 {
  "key": "7ff78bcbe610",
  "text": "그래서 오른쪽 시각로, 시각부챗살, 뒤통수엽이 손상되면 양쪽 눈의 왼쪽 시야가 사라집니다, 왼쪽 동측반맹."
 },
 {
  "key": "f31e15b3870f",
  "text": "왼쪽 뒤통수엽 손상은 오른쪽 동측반맹을 일으킵니다."
 },
 {
  "key": "04cb103244cf",
  "text": "시각교차 중앙 손상은 양쪽 바깥쪽 시야가 사라지는 양귀쪽반맹, 양이측반맹, 을 일으킵니다."
 },
 {
  "key": "e8ccd9f0bc60",
  "text": "널 진단 3: 걸음이 비틀거리고, 오른손 손가락-코 검사에서 목표를 지나친다, 겨냥이상."
 },
 {
  "key": "7a57ee6143c6",
  "text": "소뇌의 출력은 두 번 교차하기 때문에 소뇌반구 병변은 같은 쪽 팔다리의 협응 장애를 일으킵니다."
 },
 {
  "key": "f8904c94cb03",
  "text": "그래서 오른손 겨냥이상은 오른쪽 소뇌반구 병변을 시사합니다."
 },
 {
  "key": "a8a36daee7f1",
  "text": "왼쪽 소뇌반구 병변은 왼쪽 팔다리의 운동실조를 일으킵니다."
 },
 {
  "key": "1745675a2a75",
  "text": "이마엽 병변은 협응 장애보다 반대쪽 근력 약화를 주로 일으킵니다."
 },
 {
  "key": "f3c3ee14b83d",
  "text": "널 진단 4: 다리 근육이 위축되고 근육다발수축이 보이며, 무릎반사가 사라졌다."
 },
 {
  "key": "9c180c76fcbf",
  "text": "어느 쪽 병변일까?"
 },
 {
  "key": "c4ea884a0955",
  "text": "근위축, 근육다발수축, 반사 감소, 소실, 근긴장 저하는 아래운동신경세포 병변의 특징입니다."
 },
 {
  "key": "590844967044",
  "text": "위운동신경세포 병변은 반사 항진, 강직, 바빈스키 징후를 보입니다."
 },
 {
  "key": "8d040cce1658",
  "text": "위운동신경세포 병변은 반사가 오히려 증가, 항진, 합니다."
 },
 {
  "key": "305b0ca81e47",
  "text": "소뇌 병변은 근위축 없이 협응 장애를 일으킵니다."
 },
 {
  "key": "e4c098e2194d",
  "text": "널 진단 5: 말은 유창하지만 엉뚱한 단어가 섞이고, 질문을 이해하지 못한다."
 },
 {
  "key": "64cc3069edda",
  "text": "유창하지만 이해가 안 되는 수용실어증은 언어 우세 반구, 대부분 왼쪽, 위관자이랑 뒤쪽의 베르니케 영역 병변을 시사합니다."
 },
 {
  "key": "080f9da73c04",
  "text": "브로카 영역 병변은 이해는 비교적 보존되고 말이 비유창합니다."
 },
 {
  "key": "200f5afca5af",
  "text": "오른쪽 뒤통수엽 병변은 왼쪽 동측반맹을 일으킵니다."
 },
 {
  "key": "6fe3c1b15cec",
  "text": "최종 진단: 손상 부위 아래로 같은 쪽 진동, 위치감각과 운동이 사라지고, 반대쪽 통증, 온도감각이 사라졌다."
 },
 {
  "key": "4eb6cea3b785",
  "text": "진단은?"
 },
 {
  "key": "272a309e3303",
  "text": "뒤기둥-안쪽섬유띠계, 진동, 위치감각, 와 겉질척수로는 척수에서 아직 교차하지 않아 같은 쪽 증상이 생깁니다."
 },
 {
  "key": "01cab9c02c3b",
  "text": "앞가쪽계, 통증, 온도, 는 척수에 들어온 직후 교차하므로 반대쪽 증상이 생깁니다."
 },
 {
  "key": "56fe05a60a3d",
  "text": "소뇌 경색은 협응 장애와 어지럼을 일으키며, 이런 감각 해리를 만들지 않습니다."
 },
 {
  "key": "e9b4bb7b479f",
  "text": "진단으로 널을 멈추자!"
 },
 {
  "key": "5ac2c104f67a",
  "text": "반격 파동은 점프로 피할게!"
 },
 {
  "key": "36a2e761ca3d",
  "text": "정확한 진단으로 탈출로가 열렸어!"
 },
 {
  "key": "732f3eceac0c",
  "text": "신경망 복구까지 전력 질주!"
 }
]