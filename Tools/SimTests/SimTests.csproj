<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless tests for NERVE RUNNER's pure-C# core. Compiles the Unity-free Core folder plus
       the adapted CatmullRomCurve against a tiny UnityEngine math shim (UnityShim.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../NerveRunner/Assets/NerveRunner/Scripts/Core/*.cs" />
    <Compile Include="../../NerveRunner/Assets/ThirdParty/NeonRacer/CatmullRomCurve.cs" />
  </ItemGroup>
</Project>
